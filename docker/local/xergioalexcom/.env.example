# Project env vars
ASTRO_TELEMETRY_DISABLED=1

# Analytics
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_BING_SITE_VERIFICATION=

# Z.AI GLM Coding Plan (optional local AI coding agents)
# Coding Plan API key: https://z.ai/manage-apikey/apikey-list
# Used by Claude Code, OpenCode, Pi, and Cline GLM wrappers.
# Wizard: chelper  (or pnpm dlx @z_ai/coding-helper)
ZAI_CODING_API_KEY=
# Optional override (ms). Default matches Z.AI Claude Code docs.
# ZAI_CODING_API_TIMEOUT_MS=3000000
# Process-scoped model mapping for claude-glm / claudex-glm only (not settings.json).
# Defaults: opus/sonnet → glm-5.3, haiku → glm-5.3-flash. See https://docs.z.ai/devpack/latest-model
# ZAI_DEFAULT_OPUS_MODEL=glm-5.3
# ZAI_DEFAULT_SONNET_MODEL=glm-5.3
# ZAI_DEFAULT_HAIKU_MODEL=glm-5.3-flash
# For 1M context use e.g. glm-5.3[1m] above and:
# ZAI_CODING_AUTO_COMPACT_WINDOW=1000000

# OpenCode / Pi Z.AI endpoint overrides (optional)
# ZAI_CODING_BASE_URL=https://api.z.ai/api/coding/paas/v4
# ZAI_ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
# ZAI_PI_DEFAULT_MODEL=glm-5.3

# xAI / Grok coding agents (optional)
# API key: https://console.x.ai/
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_ANTHROPIC_BASE_URL=https://api.x.ai
# XAI_MODEL_DAILY=grok-4.3
# XAI_MODEL_REASONING=grok-4.6
# XAI_DEFAULT_MODEL=grok-4.3

# Azure OpenAI / Microsoft Foundry coding agents (optional)
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_RESOURCE=your-resource-name
# AZURE_OPENAI_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
# AZURE_OPENAI_MODEL_DAILY=gpt-5.4-mini-azure
# AZURE_OPENAI_MODEL_REASONING=gpt-5.4-azure
# AZURE_OPENAI_DEFAULT_MODEL=gpt-5.4-mini-azure
