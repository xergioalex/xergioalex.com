// Generated by devcontainer-kit (`dck init`) from .devcontainer/dck.toml.
// dck reconciles: dockerComposeFile, service, runServices, remoteUser,
// workspaceFolder, shutdownAction. Every other key is yours.
{
  "name": "xergioalex.com",
  "dockerComposeFile": "../docker/local/docker-compose.yaml",
  "service": "xergioalexcom",
  "runServices": ["xergioalexcom"],
  "remoteUser": "node",
  "workspaceFolder": "/app",
  // Keep the stack running when the editor window closes; `dck down` stops it.
  "shutdownAction": "none",
  "customizations": {
    "settings": {
      "terminal.integrated.shell.linux": "/bin/bash",
      "terminal.integrated.defaultProfile.linux": "bash",
      "editor.defaultFormatter": "biomejs.biome"
    },
    "vscode": {
      "extensions": [
        "eamodio.gitlens",
        "VisualStudioExptTeam.vscodeintellicode",
        "vscode-icons-team.vscode-icons",
        "biomejs.biome",
        "unifiedjs.vscode-mdx",
        "astro-build.astro-vscode",
        "bradlc.vscode-tailwindcss",
        "svelte.svelte-vscode"
      ]
    }
  }
}
