{
  "name": "xergioalex.com",
  "description": "Personal website & blog — CTO at DailyBot (YC S21), builder of digital products",
  "author": "Sergio Alexander Florez Galeano",
  "license": "MIT",
  "homepage": "https://xergioalex.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/xergioalex/xergioalex.com"
  },
  "type": "module",
  "version": "1.0.68",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "prebuild": "node scripts/generate-agent-skills-index.mjs && node scripts/build-openapi.mjs",
    "generate:agent-skills-index": "node scripts/generate-agent-skills-index.mjs",
    "astro": "astro",
    "astro:check": "astro check",
    "astro:preview": "astro preview",
    "biome:check": "biome check",
    "biome:fix": "biome check --write",
    "biome:fix:unsafe": "biome check --write --unsafe",
    "ncu:check": "ncu",
    "ncu:upgrade": "ncu -u",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "images:optimize": "node scripts/optimize-images.mjs",
    "images:optimize:slides": "node scripts/optimize-images.mjs --target=slides",
    "images:webp": "echo 'All images are natively WebP — no generation needed'",
    "search:budgets": "node scripts/check-search-performance-budgets.mjs",
    "md:check": "node scripts/check-md-parity.mjs",
    "md:check:strict": "node scripts/check-md-parity.mjs --strict",
    "lighthouse": "lhci autorun",
    "lighthouse:full": "lhci autorun --config=lighthouserc.full.cjs",
    "release": "bash .github/scripts/prepare_release.sh",
    "generate:openapi": "node scripts/build-openapi.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-satteri": "0.3.7",
    "@astrojs/mdx": "7.0.7",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/svelte": "9.0.1",
    "astro": "7.2.4",
    "fuse.js": "7.5.0",
    "reveal.js": "^6.0.1",
    "svelte": "5.56.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "1.62.1",
    "@lhci/cli": "0.15.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "20.11.6",
    "npm-check-updates": "23.0.2",
    "sharp": "0.35.3",
    "vitest": "4.1.11"
  }
}
