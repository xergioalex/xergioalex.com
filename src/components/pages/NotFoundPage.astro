---
import MainLayout from '@/layouts/MainLayout.astro';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);

/**
 * Recovery links. A dead end is where an agent (and a reader) most needs a way
 * back in, so the 404 names the machine-readable indexes as well as the pages.
 * Non-browser clients get the same list as Markdown — see
 * `functions/_middleware.ts` and `src/lib/agent-errors.ts`.
 */
const recoveryLinks = [
  { href: `${prefix}/blog/series`, label: t.notFoundRecovery.series },
  { href: `${prefix}/developers`, label: t.notFoundRecovery.developers },
  { href: '/sitemap-index.xml', label: t.notFoundRecovery.sitemap },
  { href: '/llms.txt', label: t.notFoundRecovery.llmsTxt },
];
---

<MainLayout lang={lang} title={t.notFoundPage.title} description={t.notFoundPage.description}>
  <section class="flex items-center justify-center min-h-[60vh] py-16">
    <div class="text-center max-w-lg mx-auto px-4">
      <p class="text-8xl font-bold text-secondary mb-4">404</p>
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        {t.notFoundPage.heading}
      </h1>
      <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 mb-8">
        {t.notFoundPage.message}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`${prefix}/`}
          class="inline-block px-6 py-3 bg-secondary text-white font-semibold rounded-lg hover:opacity-90 transition"
        >
          {t.notFoundPage.backHome}
        </a>
        <a
          href={`${prefix}/blog`}
          class="inline-block px-6 py-3 border-2 border-secondary text-secondary font-semibold rounded-lg hover:bg-secondary hover:text-white transition"
        >
          {t.notFoundPage.searchBlog}
        </a>
      </div>
      <div class="mt-12 text-left">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-300 mb-3">
          {t.notFoundRecovery.heading}
        </h2>
        <ul class="space-y-2">
          {recoveryLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-secondary hover:underline"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</MainLayout>
