---
import JsonLd from '@/components/JsonLd.astro';
import PageHero from '@/components/pages/PageHero.astro';
import PageSection from '@/components/pages/PageSection.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { API_ENDPOINTS } from '@/lib/api-endpoints';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);
const siteUrl =
  Astro.site?.href?.replace(/\/$/, '') ?? 'https://xergioalex.com';
const d = t.developersPage;

/**
 * Endpoint rows come from the shared list so the portal, `/api/index.json` and
 * `public/openapi.json` can never drift apart. The descriptions live in the
 * translation files, keyed by the same `operationId`.
 */
const endpoints = API_ENDPOINTS;

const errorCodes = [
  {
    code: 'resource_not_found',
    status: 404,
    text: d.errors.codes.resourceNotFound,
  },
  {
    code: 'method_not_allowed',
    status: 405,
    text: d.errors.codes.methodNotAllowed,
  },
  { code: 'gone', status: 410, text: d.errors.codes.gone },
  { code: 'internal_error', status: 500, text: d.errors.codes.internalError },
];

const agentResources = [
  {
    path: '/.well-known/ai-catalog.json',
    text: d.agentSurface.items.aiCatalog,
  },
  {
    path: '/.well-known/mcp/server-card.json',
    text: d.agentSurface.items.mcpServerCard,
  },
  {
    path: '/.well-known/agent-skills/index.json',
    text: d.agentSurface.items.agentSkills,
  },
  { path: '/.well-known/api-catalog', text: d.agentSurface.items.apiCatalog },
  { path: '/openapi.json', text: d.agentSurface.items.openapi },
  { path: '/llms.txt', text: d.agentSurface.items.llmsTxt },
  { path: '/llms-full.txt', text: d.agentSurface.items.llmsFullTxt },
  { path: '/auth.md', text: d.agentSurface.items.authMd },
];

const quickstartCommands = [
  `curl -s ${siteUrl}/api/index.json`,
  `curl -s ${siteUrl}/api/posts-${lang}.json`,
  `curl -s ${siteUrl}/api/series/${lang}/index.json`,
];

const errorExample = `$ curl -s ${siteUrl}/api/series/fr/index.json
{
  "type": "${siteUrl}/developers#errors",
  "title": "Not Found",
  "status": 404,
  "detail": "No API resource exists at /api/series/fr/index.json.",
  "instance": "/api/series/fr/index.json",
  "error": {
    "code": "resource_not_found",
    "message": "No API resource exists at /api/series/fr/index.json.",
    "hint": "Fetch ${siteUrl}/api/index.json for the list of available endpoints.",
    "documentation_url": "${siteUrl}/developers"
  }
}`;

const contactHref = `${prefix}/contact?${new URLSearchParams({
  topic: 'tech',
  subject: 'Developer API',
}).toString()}`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}${prefix}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: d.title,
      item: `${siteUrl}${prefix}/developers`,
    },
  ],
};

/**
 * WebAPI schema so name-based searches ("XergioAleX API", "XergioAleX
 * developer docs") can surface this page with its machine-readable entry
 * points attached.
 */
const apiSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebAPI',
  name: 'XergioAleX.com Public API',
  alternateName: 'XergioAleX API',
  description: d.description,
  url: `${siteUrl}${prefix}/developers`,
  documentation: `${siteUrl}${prefix}/developers`,
  termsOfService: 'https://creativecommons.org/licenses/by/4.0/',
  provider: {
    '@type': 'Person',
    name: 'Sergio Alexander Florez Galeano',
    alternateName: 'XergioAleX',
    url: siteUrl,
  },
  documentationUrl: `${siteUrl}/openapi.json`,
  potentialAction: {
    '@type': 'ConsumeAction',
    target: `${siteUrl}/api/index.json`,
  },
};

const cellClass =
  'px-4 py-3 align-top text-sm text-gray-700 dark:text-gray-200';
const headCellClass =
  'px-4 py-3 text-left text-sm font-semibold text-gray-900 dark:text-white';
const codeClass =
  'font-mono text-[0.8rem] sm:text-sm text-gray-900 dark:text-gray-100 break-all';
const tableWrapClass =
  'overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700';
const tableClass = 'min-w-full divide-y divide-gray-200 dark:divide-gray-700';
const preClass =
  'overflow-x-auto rounded-lg bg-gray-900 dark:bg-gray-950 p-4 text-[0.8rem] sm:text-sm text-gray-100 font-mono';
const linkClass = 'text-secondary hover:underline font-medium';
const cardClass =
  'rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6';
---

<MainLayout
  lang={lang}
  title={d.title}
  description={d.description}
  keywords={lang === 'en'
    ? ['XergioAleX API', 'XergioAleX developer portal', 'XergioAleX.com OpenAPI', 'XergioAleX MCP server', 'blog JSON API', 'agent ready API docs']
    : ['API de XergioAleX', 'portal de desarrolladores XergioAleX', 'OpenAPI XergioAleX.com', 'servidor MCP XergioAleX', 'API JSON de blog', 'documentación de API para agentes']}
>
  <Fragment slot="head">
    <JsonLd data={breadcrumbSchema} />
    <JsonLd data={apiSchema} />
  </Fragment>

  <PageHero
    title={d.title}
    subtitle={d.subtitle}
    description={d.heroDescription}
  />

  <!-- Quickstart -->
  <PageSection id="quickstart" title={d.quickstart.title} description={d.quickstart.description}>
    <pre class={preClass}><code>{quickstartCommands.join('\n')}</code></pre>
    <div class={`${cardClass} mt-8`}>
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
        {d.quickstart.noKeyTitle}
      </h3>
      <p class="text-gray-600 dark:text-gray-300">{d.quickstart.noKeyBody}</p>
    </div>
  </PageSection>

  <!-- Endpoints -->
  <PageSection
    id="endpoints"
    title={d.endpoints.title}
    description={d.endpoints.description}
    background="gray"
  >
    <div class={tableWrapClass}>
      <table class={tableClass}>
        <thead class="bg-gray-100 dark:bg-gray-800">
          <tr>
            <th scope="col" class={headCellClass}>{d.endpoints.colEndpoint}</th>
            <th scope="col" class={headCellClass}>{d.endpoints.colWhat}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-900">
          {endpoints.map((endpoint) => (
            <tr>
              <td class={cellClass}>
                <code class={codeClass}>GET {endpoint.pathTemplate}</code>
                <span class="block mt-1 font-mono text-xs text-gray-600 dark:text-gray-300">
                  {endpoint.operationId}
                </span>
              </td>
              <td class={cellClass}>
                {d.endpoints.descriptions[endpoint.operationId]}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-6 text-gray-600 dark:text-gray-300">
      <a class={linkClass} href="/openapi.json">openapi.json</a>
      <span aria-hidden="true"> · </span>
      <a class={linkClass} href="/api/index.json">/api/index.json</a>
    </p>
  </PageSection>

  <!-- Errors -->
  <PageSection id="errors" title={d.errors.title} description={d.errors.description}>
    <pre class={preClass}><code>{errorExample}</code></pre>

    <h3 class="mt-10 mb-4 text-xl font-semibold text-gray-900 dark:text-white">
      {d.errors.codesTitle}
    </h3>
    <div class={tableWrapClass}>
      <table class={tableClass}>
        <thead class="bg-gray-100 dark:bg-gray-800">
          <tr>
            <th scope="col" class={headCellClass}>{d.errors.colCode}</th>
            <th scope="col" class={headCellClass}>{d.errors.colMeaning}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-900">
          {errorCodes.map((entry) => (
            <tr>
              <td class={cellClass}>
                <code class={codeClass}>{entry.code}</code>
                <span class="block mt-1 font-mono text-xs text-gray-600 dark:text-gray-300">
                  HTTP {entry.status}
                </span>
              </td>
              <td class={cellClass}>{entry.text}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </PageSection>

  <!-- Versioning -->
  <PageSection
    id="versioning"
    title={d.versioning.title}
    description={d.versioning.description}
    background="gray"
  >
    <div class="grid gap-6 md:grid-cols-3">
      <div class={cardClass}>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
          {d.versioning.additiveTitle}
        </h3>
        <p class="text-gray-600 dark:text-gray-300" set:html={d.versioning.additiveBody} />
      </div>
      <div class={cardClass}>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
          {d.versioning.breakingTitle}
        </h3>
        <p class="text-gray-600 dark:text-gray-300" set:html={d.versioning.breakingBody} />
      </div>
      <div class={cardClass}>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
          {d.versioning.deprecationTitle}
        </h3>
        <p class="text-gray-600 dark:text-gray-300" set:html={d.versioning.deprecationBody} />
      </div>
    </div>
  </PageSection>

  <!-- Agent surface -->
  <PageSection
    id="agents"
    title={d.agentSurface.title}
    description={d.agentSurface.description}
  >
    <div class={tableWrapClass}>
      <table class={tableClass}>
        <thead class="bg-gray-100 dark:bg-gray-800">
          <tr>
            <th scope="col" class={headCellClass}>{d.agentSurface.colResource}</th>
            <th scope="col" class={headCellClass}>{d.agentSurface.colWhat}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-900">
          {agentResources.map((resource) => (
            <tr>
              <td class={cellClass}>
                <a class={`${codeClass} ${linkClass}`} href={resource.path}>
                  {resource.path}
                </a>
              </td>
              <td class={cellClass}>{resource.text}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p
      class="mt-6 text-gray-600 dark:text-gray-300"
      set:html={d.agentSurface.items.markdown}
    />
  </PageSection>

  <!-- Access, limits, licensing -->
  <PageSection
    id="limits"
    title={d.limits.title}
    description={d.limits.description}
    background="gray"
  >
    <div class="grid gap-6 md:grid-cols-3">
      <div class={cardClass}>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
          {d.limits.authTitle}
        </h3>
        <p class="text-gray-600 dark:text-gray-300">{d.limits.authBody}</p>
      </div>
      <div class={cardClass}>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
          {d.limits.rateLimitTitle}
        </h3>
        <p class="text-gray-600 dark:text-gray-300">{d.limits.rateLimitBody}</p>
      </div>
      <div class={cardClass}>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
          {d.limits.licenseTitle}
        </h3>
        <p class="text-gray-600 dark:text-gray-300">{d.limits.licenseBody}</p>
      </div>
    </div>
  </PageSection>

  <!-- Support -->
  <PageSection id="support" title={d.support.title} description={d.support.description}>
    <a
      href={contactHref}
      class="inline-block px-6 py-3 bg-secondary text-white font-semibold rounded-lg hover:opacity-90 transition"
    >
      {d.support.cta}
    </a>
  </PageSection>
</MainLayout>
